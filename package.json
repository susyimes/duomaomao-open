{
  "name": "duomaomao",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:check": "node scripts/verify-assets.mjs",
    "assets:validate": "node scripts/validate-models.mjs",
    "predev": "node scripts/verify-assets.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/verify-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:play": "node scripts/test-single-player.mjs",
    "build:toy": "pnpm assets:check && node scripts/build-toy.mjs",
    "toy:check": "node scripts/verify-toy.mjs",
    "test:toy": "node scripts/test-toy.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0-next.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "3.0.0-next.4",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.3",
    "@types/three": "^0.184.1",
    "@vitest/browser-playwright": "^4.1.8",
    "playwright": "^1.60.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "license": "MIT"
}
